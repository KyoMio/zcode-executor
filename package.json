{
  "name": "zcode-executor",
  "version": "0.5.7",
  "description": "Claude plans, ZCode codes, git verifies. Hand a development task to the local ZCode (GLM) agent in an isolated git worktree, with a hard-rule + model-review permission gate. 把开发任务派给本机 ZCode 执行，worktree 隔离，红线加模型审批，git diff 验收",
  "license": "Apache-2.0",
  "author": "kyomio",
  "type": "module",
  "bin": {
    "zcode-executor": "bin/zcode-executor"
  },
  "files": [
    "bin",
    "lib",
    "skills",
    "templates",
    "hooks",
    "types",
    ".claude-plugin",
    ".codex-plugin",
    ".github/plugin",
    ".grok-plugin",
    ".antigravity-plugin",
    ".agents",
    "gemini-extension.json",
    "plugin.yaml",
    "__init__.py",
    "AGENTS.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE",
    "cordis.patch.yml",
    "dsh-plugin/lib"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs && node scripts/sync-doc-version.mjs --check",
    "test:ci": "node --test --test-concurrency=1 test/*.test.mjs && node scripts/sync-doc-version.mjs --check",
    "version": "node scripts/sync-doc-version.mjs && git add README.md README.zh-CN.md .claude-plugin/plugin.json .codex-plugin/plugin.json .github/plugin/plugin.json .grok-plugin/plugin.json .antigravity-plugin/plugin.json gemini-extension.json plugin.yaml"
  },
  "keywords": [
    "zcode",
    "glm",
    "claude-code",
    "claude-code-plugin",
    "codex",
    "codex-plugin",
    "agent",
    "worktree",
    "permission-gate",
    "code-review",
    "pi-package"
  ],
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KyoMio/zcode-executor.git"
  },
  "homepage": "https://github.com/kyomio/zcode-executor#readme",
  "bugs": "https://github.com/kyomio/zcode-executor/issues",
  "main": "dsh-plugin/lib/index.js",
  "exports": {
    ".": {
      "types": "./dsh-plugin/lib/types/index.d.ts",
      "default": "./dsh-plugin/lib/index.js"
    },
    "./client": {
      "types": "./dsh-plugin/lib/types/client/index.d.ts",
      "default": "./dsh-plugin/lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    },
    "skills": [
      "./skills/zcode-executor/SKILL.md"
    ]
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.7-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.1.7-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-rc.2 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "*",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar-right": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
