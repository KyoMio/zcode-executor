{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": ".client-build",
    "declaration": true,
    "declarationDir": "lib/types",
    "sourceMap": true,
    "declarationMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": false,
    "types": [
      "react"
    ],
    "noEmitOnError": true,
    "paths": {
      "@deepseek-ai/cordis": [
        "./node_modules/@deepseek-ai/cordis/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-slots": [
        "./node_modules/@deepseek-ai/dsh-client-ui-slots/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-primitives": [
        "./node_modules/@deepseek-ai/dsh-client-ui-primitives/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-renderer/client": [
        "./node_modules/@deepseek-ai/dsh-client-ui-renderer/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-sidebar-right/client": [
        "./node_modules/@deepseek-ai/dsh-client-ui-sidebar-right/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-api-session-controller/client": [
        "./node_modules/@deepseek-ai/dsh-api-session-controller/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-api-workspace-controller/client": [
        "./node_modules/@deepseek-ai/dsh-api-workspace-controller/lib/types/client/index.d.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx"
  ],
  "exclude": [
    "lib",
    ".client-build",
    "node_modules"
  ]
}
