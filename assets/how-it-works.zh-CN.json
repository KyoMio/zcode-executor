  "cards": [
    {
      "dot": "cyan",
      "title": "契约，不是聊天",
      "items": [
        "任务单既是 ZCode 执行的内容，也是审批模型读到的授权依据",
        "活儿在隔离的 git worktree 里干，从不碰主检出"
      ]
    },
    {
      "dot": "orange",
      "title": "闸门从不拒绝",
      "items": [
        "越出执行副本的写一律停下等人",
        "模型审批只产出放行或转人工，出错也落到转人工",
        "自动放行要求有 allow_once 选项"
      ]
    },
    {
      "dot": "emerald",
      "title": "证据胜过自述",
      "items": [
        "用 git diff 和测试验收",
        "闸门每个决定都是 runs/<id>/events.jsonl 里的一条事件",
        "一条会话一个后台 runner，命令行只读文件"
      ]
    }
  ]
