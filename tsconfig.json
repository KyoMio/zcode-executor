{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "lib",
    "declarationDir": "lib/types",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/index.ts"
  ],
  "exclude": [
    "src/client",
    "lib",
    "node_modules"
  ]
}
