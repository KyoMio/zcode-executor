#!/usr/bin/env node
// 本文件负责：zcode-executor 的子命令分发——--json 与退出码表（PRD 第 4 节）在这里收口，
// 每个子命令的实现拆在 lib/cli/<name>.mjs（评审 T2.3b 第 12 条）。不含协议细节，
// 也不直接 import 协议层；未知命令列出可用命令。
import process from 'node:process';
import { ExecutorError } from '../lib/errors.mjs';
import { redactSecrets } from '../lib/scrub.mjs';
import { COMMANDS, USAGE } from '../lib/cli/common.mjs';

const argv = process.argv.slice(2);
const cmd = argv[0];

try {
  // 测试钩子（T2.6 第 2 条）：注入一个普通 Error 走下面的统一出口，验证非 ExecutorError
  // 一律退 1（RULES §5）、不打堆栈。正常使用不会带这个环境变量
  if (process.env.ZCODE_EXECUTOR_TEST_THROW) throw new Error(process.env.ZCODE_EXECUTOR_TEST_THROW);
  // 内部命令：detached runner 的入口，不走公开命令表
  if (cmd === '_runner') {
    const { run } = await import('../lib/cli/runner.mjs');
    await run(argv.slice(1));
  } else if (cmd === undefined) {
    console.error(USAGE);
    process.exitCode = 1;
  } else if (cmd === '--help' || cmd === '-h') {
    console.log(USAGE);
  } else if (!COMMANDS.includes(cmd)) {
    console.error(`zcode-executor: 不认识的命令 ${cmd}。可用命令：${COMMANDS.join('、')}`);
    process.exitCode = 1;
  } else {
    const { run } = await import(`../lib/cli/${cmd}.mjs`);
    await run(argv.slice(1));
  }
} catch (err) {
  // 未接住的错统一一行 stderr + 退出码（RULES §5）；非 ExecutorError 默认只打 message，
  // 设 ZCODE_EXECUTOR_DEBUG=1 才打堆栈（评审 T2.1b 第 11 条），且多打一行脱敏后的 details（T2.9 第 9 条）
  const prefix = cmd && (COMMANDS.includes(cmd) || cmd === '_runner') ? cmd : 'zcode-executor';
  const isOurs = err instanceof ExecutorError;
  const detail = isOurs || !process.env.ZCODE_EXECUTOR_DEBUG ? err?.message : err?.stack;
  console.error(`${prefix}: ${detail ?? err}`);
  if (process.env.ZCODE_EXECUTOR_DEBUG && err?.details !== undefined) {
    console.error(`${prefix}: details = ${JSON.stringify(redactSecrets(err.details))}`);
  }
  process.exitCode = isOurs ? (err.exitCode ?? 1) : 1;
}
